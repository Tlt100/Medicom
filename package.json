{
  "name": "patientshield",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Know your healthcare rights. Hold your insurer to them. Educational NJ + federal patient-rights and insurance-denial navigator.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "make:samples": "node scripts/make-sample-pdf.mjs"
  },
  "dependencies": {
    "@fontsource/newsreader": "^5.3.0",
    "@fontsource/public-sans": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "vitest-axe": "^0.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
