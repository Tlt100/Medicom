# PatientShield needs NO secrets. Demo mode with synthetic letters works with this file empty.
# Copy to .env only if you want to override defaults. Never commit a real .env.

# development | production   (production disables the /api/docs page)
PATIENTSHIELD_ENV=development
# Max request size in bytes (Vercel's own hard limit is 4.5 MB).
PATIENTSHIELD_MAX_REQUEST_BYTES=4194304
# PATIENTSHIELD_ENABLE_DOCS=true

# Reserved for a future, optional AI explanation provider. Server-side only, never VITE_*.
# ANTHROPIC_API_KEY=
